# Ballot Guide — Environment Variables
# Copy to .env and fill in values before starting.
#
# For Azure deployment, secrets are stored as Container Apps secrets
# and passed via GitHub Actions. See infra/main.bicep and
# .github/workflows/deploy.yml for details.

# ─── Gemini ──────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ─── External APIs (MCP servers) ─────────────
GOOGLE_CIVIC_API_KEY=your-google-civic-api-key-here
NEWSAPI_KEY=your-newsapi-key-here
OPENFEC_API_KEY=your-openfec-api-key-here

# ─── Database ────────────────────────────────
DB_PATH=/data/ballot-guide.db

# ─── Application ─────────────────────────────
APP_VERSION=1.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3003"]

# ─── Development ─────────────────────────────
MOCK_EXTERNAL_APIS=false
MOCK_LLM=false

# ─── Per-source mock overrides ───────────────
# Only checked when MOCK_EXTERNAL_APIS=false.
# Set individual sources to true to mock just that source.
MOCK_CIVIC_API=false
MOCK_OPENFEC_API=false
MOCK_FL_FINANCE_API=false
MOCK_BALLOTPEDIA_API=false
MOCK_FL_ELECTIONS_API=false
MOCK_NEWSAPI=false
MOCK_LEGISLATION_API=false
